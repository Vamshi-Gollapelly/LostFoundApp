<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Radius filter controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#1F3864">

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOST &amp; FOUND MAP"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView android:id="@+id/tvRadius"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Radius: 10 km"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <SeekBar android:id="@+id/seekRadius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"/>

        <Button android:id="@+id/btnFilter"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="APPLY RADIUS FILTER"
            android:textSize="13sp"
            android:backgroundTint="#27AE60"/>

    </LinearLayout>

    <!-- Map fragment fills remaining space -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</LinearLayout>
